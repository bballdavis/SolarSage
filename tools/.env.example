# Copy to tools/.env (git-ignored) and fill in. The environment wins over this file.
HASS_URL=http://homeassistant.local:8123
# A long-lived access token: your HA profile -> Security -> Long-lived access tokens.
HASS_TOKEN=
# Only for an HTTPS instance with its own certificate authority:
# HASS_CA_FILE=/path/to/ca.pem
