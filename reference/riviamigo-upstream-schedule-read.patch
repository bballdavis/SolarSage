+
+fn complete_charging_schedule(data: ChargingScheduleData) -> Result<Vec<ChargePolicyItem>> {
+    let schedules = data
+        .get_vehicle
+        .ok_or_else(|| anyhow!("Rivian charging schedule response omitted vehicle"))?
+        .charging_schedules
+        .ok_or_else(|| anyhow!("Rivian charging schedule response omitted schedule list"))?;
+
+    for schedule in &schedules {
+        let complete = schedule.enabled.is_some()
+            && schedule.start_time.is_some()
+            && schedule.duration.is_some()
+            && schedule.amperage.is_some()
+            && schedule
+                .location
+                .as_ref()
+                .and_then(|location| location.latitude)
+                .is_some()
+            && schedule
+                .location
+                .as_ref()
+                .and_then(|location| location.longitude)
+                .is_some()
+            && schedule
+                .week_days
+                .as_ref()
+                .is_some_and(|week_days| !week_days.is_empty());
+        if !complete {
+            return Err(anyhow!(
+                "Rivian charging schedule response contained a partial entry"
+            ));
+        }
+    }
+
+    Ok(schedules)
+}
+
+/// Read the complete charging schedule directly from Rivian without changing
+/// the local schedule row. Null provider fields are incomplete responses.
+pub async fn fetch_charging_schedule_upstream(
+    rivian_vehicle_id: &str,
+    vehicle_id: Uuid,
+    pool: &PgPool,
+    client: &reqwest::Client,
+    tokens: &RivianTokenBundle,
+) -> Result<UpstreamChargingSchedule> {
+    const Q: &str = r#"
+        query GetChargingSchedule($vehicleId: String!) {
+          getVehicle(id: $vehicleId) {
+            chargingSchedules {
+              enabled
+              startTime
+              duration
+              amperage
+              location {
+                latitude
+                longitude
+              }
+              weekDays
+            }
+          }
+        }
+    "#;
+
+    let vars = serde_json::json!({ "vehicleId": rivian_vehicle_id });
+    let data: ChargingScheduleData =
+        gql_request(client, GATEWAY_URL, tokens, "GetChargingSchedule", Q, vars).await?;
+    let schedules = complete_charging_schedule(data)?;
+    let observed_at = Utc::now();
+
+    increment_poll_counter(pool, vehicle_id).await;
+    Ok(UpstreamChargingSchedule {
+        schedules,
+        observed_at,
+    })
+}
+
+pub async fn fetch_charging_schedule_upstream_for_vehicle(
+    vehicle_id: Uuid,
+    pool: &PgPool,
+    client: &reqwest::Client,
+    age_key: &str,
+) -> Result<UpstreamChargingSchedule> {
+    with_vehicle_auth_retry(
+        vehicle_id,
+        pool,
+        client,
+        age_key,
+        "fetch_charging_schedule_upstream",
+        move |rivian_vehicle_id, tokens, pool, client| {
+            Box::pin(async move {
+                fetch_charging_schedule_upstream(
+                    rivian_vehicle_id,
+                    vehicle_id,
+                    pool,
+                    client,
+                    tokens,
+                )
+                .await
+            })
+        },
+    )
+    .await
 }
 
