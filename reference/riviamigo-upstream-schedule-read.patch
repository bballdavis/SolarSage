+async fn reject_demo_schedule_read(pool: &sqlx::PgPool, vehicle_id: Uuid) -> Result<(), AppError> {
+    let key = sqlx::query_scalar::<_, String>(
+        "SELECT rivian_vehicle_id FROM riviamigo.vehicles WHERE id=$1",
+    )
+    .bind(vehicle_id)
+    .fetch_optional(pool)
+    .await?
+    .ok_or(AppError::NotFound)?;
+    if key.starts_with("demo-") {
+        return Err(AppError::Validation(
+            "demo vehicles are historical examples and cannot perform upstream Rivian reads".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Read a fresh complete provider schedule. This is deliberately session-only
+/// and manager/owner scoped because it reaches Rivian directly.
+async fn get_upstream_charging_schedule(
+    auth: AuthUser,
+    State(state): State<AppState>,
+    Path(vehicle_id): Path<Uuid>,
+) -> Result<(HeaderMap, Json<rivian_poll::UpstreamChargingSchedule>), AppError> {
+    require_vehicle_manager_access(&state.pool, &auth, vehicle_id).await?;
+    reject_demo_schedule_read(&state.pool, vehicle_id).await?;
+
+    let client = http_client()?;
+    let snapshot = rivian_poll::fetch_charging_schedule_upstream_for_vehicle(
+        vehicle_id,
+        &state.pool,
+        &client,
+        &state.age_key,
+    )
+    .await
+    .map_err(|_| AppError::RivianApi("Rivian charging schedule read failed".into()))?;
+
+    let mut headers = HeaderMap::new();
+    headers.insert(
+        axum::http::header::CACHE_CONTROL,
+        "no-store".parse().unwrap(),
+    );
+    Ok((headers, Json(snapshot)))
+}
