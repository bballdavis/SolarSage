{
  "entity": {
    "binary_sensor": {
      "charging_wanted": {
        "default": "mdi:ev-station",
        "state": {
          "off": "mdi:pause-circle-outline"
        }
      }
    },
    "number": {
      "battery_floor": {
        "default": "mdi:battery-arrow-down-outline"
      },
      "battery_wanted_at_free_hours": {
        "default": "mdi:battery-clock-outline"
      },
      "minimum_time_between_changes": {
        "default": "mdi:timer-sand"
      },
      "largest_change": {
        "default": "mdi:stairs"
      },
      "paid_grid_tolerance": {
        "default": "mdi:transmission-tower-import"
      },
      "import_price": {
        "default": "mdi:cash"
      },
      "solar_buyback": {
        "default": "mdi:cash-refund"
      },
      "window_price": {
        "default": "mdi:cash-clock"
      },
      "charge_limit": {
        "default": "mdi:battery-charging-80"
      },
      "plan_target": {
        "default": "mdi:target"
      },
      "restore_current": {
        "default": "mdi:restore"
      },
      "tesla_api_budget": {
        "default": "mdi:piggy-bank-outline"
      },
      "tesla_polling_estimate": {
        "default": "mdi:cloud-sync-outline"
      },
      "tesla_refresh_interval": {
        "default": "mdi:refresh-auto"
      },
      "solar_current": {
        "default": "mdi:current-ac"
      }
    },
    "select": {
      "caution": {
        "default": "mdi:weather-partly-cloudy"
      },
      "night_charging_start": {
        "default": "mdi:weather-night"
      },
      "charger_car_override": {
        "default": "mdi:car-select"
      },
      "plan_days": {
        "default": "mdi:calendar-week"
      }
    },
    "sensor": {
      "mode": {
        "default": "mdi:state-machine",
        "state": {
          "day": "mdi:solar-power-variant",
          "night": "mdi:weather-night",
          "off": "mdi:power-off",
          "no_data": "mdi:alert-circle-outline"
        }
      },
      "reason": {
        "default": "mdi:message-text-outline"
      },
      "next_change": {
        "default": "mdi:clock-start"
      },
      "battery_minimum": {
        "default": "mdi:battery-arrow-down"
      },
      "battery_minimum_time": {
        "default": "mdi:battery-clock"
      },
      "forecast_correction": {
        "default": "mdi:sun-compass"
      },
      "car_on_charger": {
        "default": "mdi:ev-plug-type2",
        "state": {
          "none": "mdi:power-plug-off-outline"
        }
      },
      "heartbeat": {
        "default": "mdi:heart-pulse"
      },
      "planned_current": {
        "default": "mdi:current-ac"
      },
      "charging_until": {
        "default": "mdi:clock-end"
      },
      "outlook": {
        "default": "mdi:crystal-ball"
      },
      "solar_energy": {
        "default": "mdi:solar-power"
      },
      "free_energy": {
        "default": "mdi:weather-night"
      },
      "paid_energy": {
        "default": "mdi:cash"
      },
      "tesla_api_spend": {
        "default": "mdi:cash-check"
      },
      "control_state": {
        "default": "mdi:state-machine",
        "state": {
          "fault": "mdi:alert-circle-outline",
          "lease_active": "mdi:ev-station",
          "paused": "mdi:pause-circle-outline",
          "handed_back": "mdi:account-arrow-left-outline"
        }
      },
      "charger_status": {
        "default": "mdi:ev-plug-type1",
        "state": {
          "a": "mdi:power-plug-off-outline",
          "c": "mdi:battery-charging"
        }
      }
    },
    "switch": {
      "planning": {
        "default": "mdi:robot",
        "state": {
          "off": "mdi:robot-off"
        }
      },
      "shadow_mode": {
        "default": "mdi:eye-outline",
        "state": {
          "off": "mdi:send-outline"
        }
      },
      "daytime_solar_charging": {
        "default": "mdi:solar-power-variant",
        "state": {
          "off": "mdi:solar-power-variant-outline"
        }
      },
      "solar_charging": {
        "default": "mdi:solar-power-variant",
        "state": {
          "off": "mdi:solar-power-variant-outline"
        }
      },
      "lease_renewal": {
        "default": "mdi:timer-refresh-outline"
      }
    },
    "time": {
      "plan_time": {
        "default": "mdi:clock-check-outline"
      }
    },
    "button": {
      "release": {
        "default": "mdi:restore"
      },
      "clear_fault": {
        "default": "mdi:alert-remove-outline"
      },
      "read_schedules": {
        "default": "mdi:calendar-search"
      }
    }
  },
  "services": {
    "release": {
      "service": "mdi:restore"
    },
    "clear_fault": {
      "service": "mdi:alert-remove-outline"
    },
    "abandon_ownership": {
      "service": "mdi:link-variant-off"
    },
    "force_restore": {
      "service": "mdi:backup-restore"
    },
    "read_schedules": {
      "service": "mdi:calendar-search"
    }
  }
}
